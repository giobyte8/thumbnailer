
LOG_LEVEL=DEBUG

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=/

AMQP_EXCHANGE=GL_EXCHANGE
AMQP_QUEUE_THUMB_GEN_REQUESTS=GL_GEN_THUMB_REQUESTS
AMQP_QUEUE_THUMB_DEL_REQUESTS=GL_DEL_THUMB_REQUESTS

DIR_ORIGINALS_ROOT=runtime/originals
DIR_THUMBNAILS_ROOT=runtime/thumbs

THUMBNAIL_WIDTHS_PX="256,512"

# The maximin allowed dimension for images being processed.
# This dimension applies to any of both axis (width or height)
MAX_ALLOWED_IMAGE_DIMENSION_PX=4096

# Optional resource retention period in seconds. Defaults to 300 seconds.
# LP_RESOURCES_MEMORY_RETENTION_PERIOD=300


# === === === === === === === === === === === ===
# Telemetry settings

OTEL_ENABLED=true

# gRPC collector endpoint
OTEL_COLLECTOR_GRPC_ENDPOINT=localhost:4317

# Optional comma-separated OpenTelemetry resource attributes.
# - If `service.namespace` isn't specified, app fallbacks to 'galleries'
# - If `service.name` isn't specified, app fallbacks to 'thumbnailer'
# - If 'service.instance.id' isn't specified, app fallbacks
#   to the container hostname, or a random UUID if necessary.
#
# Each concurrently running container must have a unique instance Id,
# hence, not providing an instance id here is recommended.
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=galleries,service.name=thumbnailer
